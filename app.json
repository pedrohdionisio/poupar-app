{
  "expo": {
    "name": "Poupar",
    "slug": "poupar",
    "scheme": "poupar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.poupar.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.poupar.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "O Poupar usa a câmera para fotografar suas notas fiscais e importar as compras.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Poupar acessa suas fotos para você escolher a imagem de uma nota fiscal que já está no aparelho."
        }
      ],
      "expo-secure-store"
    ]
  }
}
